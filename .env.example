DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_PUBLIC_SITE_URL=https://example.com
NOTIFICATION_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
DJANGO_FROM_EMAIL=no-reply@example.com
DJANGO_SMTP_HOST=smtp.example.com
DJANGO_SMTP_PORT=587
DJANGO_SMTP_USER=replace-with-smtp-user
DJANGO_SMTP_PASSWORD=replace-with-smtp-password
DJANGO_SMTP_USE_TLS=true
DJANGO_SMTP_USE_SSL=false
